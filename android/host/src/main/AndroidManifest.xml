<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Agent Presence"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Plain backdrop for screenshots (README images). -->
        <activity
            android:name=".ShowcaseActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

        <!-- Events from an agent on a computer, over adb (SPEC §6). Only the adb shell holds DUMP,
             so other apps on the phone cannot fake an agent. -->
        <receiver
            android:name=".EventReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.deniz.agentpresence.EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
